{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(bun install)",
      "Bash(bun install:*)",
      "Bash(bun run dev)",
      "Bash(bun run dev:isolated)",
      "Bash(bun run dev:isolated:*)",
      "Bash(bun run check)",
      "Bash(bun run test)",
      "Bash(bun run test:*)",
      "Bash(bun run lint)",
      "Bash(bun run format)",
      "Bash(bun run typecheck)",
      "Bash(bun run e2e)",
      "Bash(bun run e2e:*)",
      "Bash(bun run db:*)",
      "Bash(bun run docker:build)",
      "Bash(bun test:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/post-edit.ts",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/stop-check.ts",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
