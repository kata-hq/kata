{
  "name": "kata",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "bun run db:generate",
    "dev": "bun run --parallel --filter @kata/api --filter @kata/web dev",
    "dev:isolated": "bun --no-env-file scripts/dev-isolated.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck && tsc --noEmit -p scripts && tsc --noEmit -p tests/architecture",
    "test": "bun run --filter '*' test",
    "test:unit": "bun run --filter '*' test",
    "test:coverage": "bun run --filter '*' test:coverage",
    "e2e": "bun apps/e2e/run.ts",
    "e2e:install": "bun run --filter @kata/e2e install-browsers",
    "test:int": "bun --config=bunfig.int.toml test .int.test.ts",
    "test:arch": "bun test tests/architecture",
    "test:scripts": "bun test scripts",
    "check": "bun scripts/check.ts",
    "db:up": "docker compose up -d --wait postgres",
    "db:migrate": "bun scripts/db-migrate-all.ts",
    "db:reset": "bun scripts/db-reset.ts",
    "db:seed": "bun scripts/db-seed.ts",
    "db:studio": "bun scripts/db-studio.ts",
    "db:generate": "bun scripts/db-generate.ts",
    "docker:build": "docker build -f apps/api/Dockerfile -t kata-api . && docker build -f apps/web/Dockerfile -t kata-web .",
    "docker:up": "docker compose --profile app up -d --wait",
    "docker:down": "docker compose --profile app rm --stop --force migrate api web"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@kata/config": "workspace:*",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
