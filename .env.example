# Copy to `.env`. Bun and docker compose read it from the repository root.

# Host port of the Postgres container (change it if 5432 is taken; update the URLs below too).
POSTGRES_PORT=5432
# Database created when the container starts for the first time.
POSTGRES_DB=kata

# One database for every module. Each module selects its own Postgres schema.
DATABASE_URL=postgres://kata:kata@localhost:5432/kata
# Integration tests. The name must end in `_test`; it is created and migrated automatically.
TEST_DATABASE_URL=postgres://kata:kata@localhost:5432/kata_test

# API (apps/api). Change API_PORT if 3000 is taken.
API_PORT=3000
# debug, info, warn or error.
LOG_LEVEL=info

# Web dev server (apps/web). Change WEB_PORT if 5173 is taken.
WEB_PORT=5173
# Where the web dev server proxies `/api`. Defaults to http://localhost:${API_PORT}.
# API_URL=http://localhost:3000
